{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/", "destination": "/app.html" },
    { "source": "/library", "destination": "/library.html" }
  ],
  "functions": {
    "api/summarise.js": { "maxDuration": 300 },
    "api/generate-audio.js": { "maxDuration": 300 },
    "api/tts-stream.js": { "maxDuration": 300 },
    "api/tts.js": { "maxDuration": 60 },
    "api/es-pipeline.js": { "maxDuration": 300 },
    "api/send-to-kindle.js": { "maxDuration": 30, "includeFiles": "lib/fonts/**" }
  },
  "headers": [
    {
      "source": "/(app|index|library|summary|kernl-ui|scenes).js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/kernl.css",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "x-vercel-skip-toolbar", "value": "1" }]
    }
  ]
}
